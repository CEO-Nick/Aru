{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aru",
  "version": "0.2.8",
  "identifier": "dev.aruu.aru",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aru",
        "width": 320,
        "height": 470,
        "minWidth": 260,
        "minHeight": 300,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "entitlements": "Aru.entitlements"
    },
    "category": "Productivity"
  }
}
